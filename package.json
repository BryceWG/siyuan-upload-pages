{
  "name": "siyuan-upload-pages",
  "version": "0.1.0",
  "type": "module",
  "description": "PaperKite - publish a SiYuan document as a self-contained static page",
  "repository": "https://github.com/BryceWG/siyuan-upload-pages",
  "homepage": "https://github.com/BryceWG/siyuan-upload-pages",
  "author": "Bryce",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline vite build --watch",
    "check": "run-s check:types check:svelte lint format:check",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node ./scripts/clean.js",
    "build": "run-s clean build:app",
    "build:app": "cross-env NODE_ENV=production vite build",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "make-link-win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/elevate.ps1 -scriptPath ./scripts/make_dev_link.js",
    "update-version": "node --no-warnings ./scripts/update_version.js",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "globals": "^17.12.0",
    "js-yaml": "^5.4.1",
    "livereload": "^0.9.3",
    "minimist": "^1.2.8",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.103.1",
    "siyuan": "1.2.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
