{
  "name": "siyuan-upload-pages",
  "author": "Bryce",
  "url": "https://github.com/BryceWG/siyuan-upload-pages",
  "version": "0.1.1",
  "minAppVersion": "3.8.0",

  "kernels": ["all"],
  "disabledInPublish": true,
  "backends": ["windows", "linux", "darwin", "ios", "android", "harmony", "docker"],
